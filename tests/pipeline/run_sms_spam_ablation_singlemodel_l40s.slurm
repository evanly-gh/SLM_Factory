#!/bin/bash
#SBATCH --job-name=slm-sms-spam-ablation-singlemodel-l40s
#SBATCH --account=gpu-l40s-intelligentsystems
#SBATCH --partition=gpu-l40s
#SBATCH --qos=normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:l40s:2
#SBATCH --cpus-per-task=16
#SBATCH --mem=160G
#SBATCH --time=12:00:00
#SBATCH --requeue
#SBATCH --signal=B:USR1@7200
#SBATCH --output=/mmfs1/gscratch/intelligentsystems/evanly/SLM_Factory/logs/slurm/slm-sms-spam-ablation-singlemodel-l40s-%j.out
#
# ============================================================================================
# ABLATION — ONE SHOT AT THE WHOLE POOL (orchestrator picks once, no ladder)
#
# Added 2026-10-06, extending `run_ner_bc5cdr_ablation_singlemodel_l40s.slurm` (job 40831542) to
# the rest of the ten-task suite. GENERATED by `scripts/gen_singlemodel_ablations.py` from
# `run_sms_spam_l40s.slurm` — every line below the header is that file's, unchanged, plus the two
# exports at the bottom. Do not hand-edit; change the generator and re-run it.
#
# BASELINE: slm-sms-spam-ablation-nostop-l40s-40105478
#   best: 0.9609 minority_f1 at T3 Qwen3-1.7B@Q4_K_M
#
# Same task, same data, same teacher and same goal — but instead of starting in the smallest tier
# and climbing, the orchestrator sees ALL 27 feasible variants at once, picks one, and the run
# stays on it: no escalation on failure, no downward probe on success. It ends when that model
# meets the goal, stagnates, or hits the 30-eval cap.
#
# The pick is `orchestrator_choice_node` verbatim (`single_model` delegates to it): candidates
# listed smallest first with their tier, size and published metrics, and an instruction to take
# the most resource-efficient variant that can plausibly reach the goal after LoRA fine-tuning.
# The chosen selector and the orchestrator's one-sentence reason are printed at the top of the log.
#
# WHAT IT ANSWERS: does one informed choice get to the baseline's answer faster than climbing?
# If the orchestrator picks the baseline's winning tier it skips every iteration below it; if it
# picks smaller it may never reach the baseline's best; if it picks larger it pays in on-device
# size for accuracy the task did not need. All three outcomes are the finding.
#
# ON THIS TASK SPECIFICALLY: The cheapest task in the suite per iteration and the only one whose
# score AND search gain peak at the same tier. Same pinned-goal confound as clinc150. Minority-
# class F1 means a pick too small to separate the classes reports 0.0 rather than a flattering
# 0.87, so a bad choice here is unambiguous.
#
# THE GOAL IS LEFT CALIBRATED, deliberately. It appears in the selection prompt, so pinning it at
# 0.99 to force a run-to-stagnation would push the orchestrator toward the largest model and turn
# this into a different experiment. The orchestrator may raise it mid-run, as the ner baseline's
# did (0.80 -> 0.85), so both runs stop under the same rule.
#
# EXPECTED COST: ~6 min per train+eval iteration (09-16 note, IV.3), and the ner arm
# took 9 iterations. Budget 3-4h including ~50 min of fixed setup (vLLM boot,
# eval_setup, the four contamination firewalls, difficulty labelling, teacher measurement). The
# upper figure is the 30-eval cap. That per-iteration number is a LADDER AVERAGE across every tier
# the baseline visited; a single-model run sits on one variant, so expect +/-40% depending on how
# large the orchestrator picks.
#
# WALL CLOCK: 12h, NOT the baseline's seven days. This arm is pinned to one variant and
# bounded by the 30-eval cap, so it cannot run for days; and a seven-day request is unschedulable
# ahead of the cluster's October13_Maintenance reservation and gets no backfill on a 10-GPU account
# shared by a dozen users. 12h is ~2x the worst case above. The USR1
# checkpoint-and-requeue contract still fires two hours before the wall, so an overrun resumes
# rather than dying.
#
# `unset SLM_SYNTH_API_MODE` keeps the local Qwen teacher the baseline used: sbatch forwards the
# submitting shell's environment, which is how run 39361648 silently became a DeepSeek run.
# ============================================================================================
# CURATED BENCHMARK: sms_spam (in-distribution, metric minority_f1). SLM_BENCHMARK_TASK pins the
# deterministic loader (the checksummed data/local/sms_spam bundle, HuggingFace ucirvine/sms_spam
# as the fallback) instead of autonomous web_acquire — run.py starts the run NON-autonomous
# against this task's registry spec, which is where its loader, scorer, metric and token budget
# are declared.
#
# WHY THE METRIC IS minority_f1 AND NOT accuracy. The corpus is ~87% ham. Answering `ham` for
# every message scores 0.87 accuracy and ~0.47 macro-F1, both of which look like a working model.
# Minority-class F1 scores it 0.0. This task is the suite's cheapest collapse detector and the
# metric is the only reason that is true — see tasks/sms_spam.py.
#
# HISTORY WORTH KNOWING: an sms_spam loader existed before 2026-08-18 and was deleted with the
# `task_type` channel. It is not restored, it is rewritten: the old split was unshuffled (B44), the
# corpus was never deduplicated so copies of the same message sat on both sides of the firewall,
# and the data came over plain HTTP with no checksum. All three are fixed in the new loader.
#
# Dedicated gpu-l40s-intelligentsystems quota: 2x L40S (synth server on GPU0, pipeline on GPU1 —
# the auto-2gpu profile in _l40s_task_body.sh). --requeue + USR1 checkpoint contract is a safety
# net against node failure/maintenance.
export SLM_CUDA_ISOLATION=1
export SLM_BENCHMARK_TASK=sms_spam
export TASK="Fine tune a small model to classify SMS text messages as unsolicited spam or legitimate (ham), targeting deployment on my Samsung Galaxy S24 Ultra with 12GB RAM and 256GB storage"
export SLM_MODEL_SELECTION_STRATEGY=single_model
unset SLM_SYNTH_API_MODE
source /mmfs1/gscratch/intelligentsystems/evanly/SLM_Factory/tests/pipeline/_l40s_task_body.sh
