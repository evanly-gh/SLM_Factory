#!/bin/bash
#SBATCH --job-name=slm-calendar-json-ablation-singlemodel-l40s
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:l40s:2
#SBATCH --cpus-per-task=16
#SBATCH --mem=160G
#SBATCH --time=18:00:00
#SBATCH --requeue
#SBATCH --signal=B:USR1@7200
#SBATCH --output=logs/slurm/slm-calendar-json-ablation-singlemodel-l40s-%j.out
#
# ============================================================================================
# ABLATION — ONE SHOT AT THE WHOLE POOL (orchestrator picks once, no ladder)
#
# Added 2026-10-06, extending `run_ner_bc5cdr_ablation_singlemodel_l40s.slurm` (job 40831542) to
# the rest of the ten-task suite. GENERATED by `scripts/gen_singlemodel_ablations.py` from
# `run_calendar_json_l40s.slurm` — every line below the header is that file's, unchanged, plus the two
# exports at the bottom. Do not hand-edit; change the generator and re-run it.
#
# BASELINE: slm-calendar-json-l40s-39294409
#   best: 0.8748 ast_arg_match at T3 Qwen3.5-2B@Q4_K_M
#
# Same task, same data, same teacher and same goal — but instead of starting in the smallest tier
# and climbing, the orchestrator sees ALL 27 feasible variants at once, picks one, and the run
# stays on it: no escalation on failure, no downward probe on success. It ends when that model
# meets the goal, stagnates, or hits the 30-eval cap.
#
# The pick is `orchestrator_choice_node` verbatim (`single_model` delegates to it): candidates
# listed smallest first with their tier, size and published metrics, and an instruction to take
# the most resource-efficient variant that can plausibly reach the goal after LoRA fine-tuning.
# The chosen selector and the orchestrator's one-sentence reason are printed at the top of the log.
#
# WHAT IT ANSWERS: does one informed choice get to the baseline's answer faster than climbing?
# If the orchestrator picks the baseline's winning tier it skips every iteration below it; if it
# picks smaller it may never reach the baseline's best; if it picks larger it pays in on-device
# size for accuracy the task did not need. All three outcomes are the finding.
#
# ON THIS TASK SPECIFICALLY: One of two tasks whose ladder stopped at three tiers, so the
# orchestrator's pick has a well-identified target. Its highest-gain tier was T1 and the gain was
# ENTIRELY mining — the one task in the suite where that is true — so a one-shot run that skips
# the small tiers also skips where its baseline's data lever actually paid.
#
# THE GOAL IS LEFT CALIBRATED, deliberately. It appears in the selection prompt, so pinning it at
# 0.99 to force a run-to-stagnation would push the orchestrator toward the largest model and turn
# this into a different experiment. The orchestrator may raise it mid-run, as the ner baseline's
# did (0.80 -> 0.85), so both runs stop under the same rule.
#
# EXPECTED COST: ~12 min per train+eval iteration (09-16 note, IV.3), and the ner arm
# took 9 iterations. Budget 4-7h including ~50 min of fixed setup (vLLM boot,
# eval_setup, the four contamination firewalls, difficulty labelling, teacher measurement). The
# upper figure is the 30-eval cap. That per-iteration number is a LADDER AVERAGE across every tier
# the baseline visited; a single-model run sits on one variant, so expect +/-40% depending on how
# large the orchestrator picks.
#
# WALL CLOCK: 18h, NOT the baseline's seven days. This arm is pinned to one variant and
# bounded by the 30-eval cap, so it cannot run for days; and a seven-day request is unschedulable
# ahead of the cluster's October13_Maintenance reservation and gets no backfill on a 10-GPU account
# shared by a dozen users. 18h is ~2x the worst case above. The USR1
# checkpoint-and-requeue contract still fires two hours before the wall, so an overrun resumes
# rather than dying.
#
# `unset SLM_SYNTH_API_MODE` keeps the local Qwen teacher the baseline used: sbatch forwards the
# submitting shell's environment, which is how run 39361648 silently became a DeepSeek run.
# ============================================================================================
# CURATED BENCHMARK: calendar_json (format-bound, metric ast_arg_match). SLM_BENCHMARK_TASK pins the
# deterministic loader — TOPv2 reminder utterances plus the frozen SGD Calendar_1 bundle — instead of
# autonomous web_acquire, so run.py starts NON-autonomous against this task's registry spec, where its
# loader, scorer, metric and token budget are declared.
#
# What makes this task different from xlam_bfcl, and why it is worth running alongside it: the answer
# is not merely a well-formed call, it is a RESOLVED one. Every gold label required turning a relative
# expression ("tomorrow", "tonight", "Friday at 4") into an absolute ISO-8601 instant against a
# per-row reference. That makes it the only task in the registry whose synthetic rows can be checked
# for CONTENT rather than form, by re-resolving the request with the loader's own grammar
# (`data/synth_verifiers.verify_calendar_row`) — no teacher call, no judgement.
#
# Dedicated allocation: 2x L40S (synth server on GPU0, pipeline on GPU1 — the
# auto-2gpu profile in _l40s_task_body.sh). --requeue + USR1 checkpoint contract is the safety net
# against node failure and maintenance across a 7-day reservation.
export SLM_CUDA_ISOLATION=1
export SLM_BENCHMARK_TASK=calendar_json
# TEACHER VERIFICATION OF GENERATED ROWS: OFF for this task.
#
# This task has an EXACT programmatic verifier (`TaskSpec.synth_verifier`) that already checks every
# decidable property of a generated row. The teacher pass runs after it and, measured on 2026-08-25,
# does net harm on exactly these tasks:
#   ner_bc5cdr    verify_ner_row passed 25/25; the teacher then rejected 25/25 for "format", twice
#                 running, which is what stopped the run.
#   calendar_json 1,965 of 8,704 rows rejected (22.6%), including "7pm start plus 60 mins is 8pm,
#                 not 20:00" -- 8pm IS 20:00 -- and six rejections of the year-roll the gold uses.
#
# `verifier_notes` was added to tell the teacher the conventions it was missing, but whether an LLM
# then complies is not something a unit test can establish, and a false rejection is expensive: it
# removes a good row AND can stop the run. Until the notes are shown to lower the rejection rate on a
# live run, the exact verifier is trusted on its own. Set SLM_VERIFY_SYNTH=1 to measure the pass again.
export SLM_VERIFY_SYNTH=0
# SYNTHESIS GATE: bypassed deliberately, and the measurement is still taken honestly.
#
# The local teacher measures ast_arg_match 0.3850-0.7950 across runs (0.6318 on 39294409), never
# clearing the 0.80 gate, so `synthesis_allowed` refuses surgical_synthesis and the orchestrator
# spends the run on mining and hyperparameters instead. On 39294409 that is exactly what happened:
# fourteen iterations reasoned "surgical_synthesis is blocked by the 0.6318<0.80 teacher gate", and
# a single synthesis batch ran only after mining exhausted every source and the plan validator
# rewrote mine_new_real into surgical_synthesis. That batch kept 300 of 300, so the generator is
# fine; the gate, not the data, is what kept it off the menu.
#
# Runs 38832587 and 39294409 differed only in whether this flag was exported in the SUBMITTING
# SHELL. It lives here now so the run is reproducible from the file. BYPASS changes only the
# DECISION — the score, the real gate and `bypassed=True` are still recorded on the verdict.
export SLM_TEACHER_SYNTH_BYPASS=1

export TASK="Fine tune a small model to convert natural-language scheduling requests into Google Calendar events.insert JSON with resolved ISO-8601 timestamps, targeting deployment on my Samsung Galaxy S24 Ultra with 12GB RAM and 256GB storage"
export SLM_MODEL_SELECTION_STRATEGY=single_model
unset SLM_SYNTH_API_MODE
source "${SLM_ROOT:-$SLURM_SUBMIT_DIR}/tests/pipeline/_l40s_task_body.sh"
