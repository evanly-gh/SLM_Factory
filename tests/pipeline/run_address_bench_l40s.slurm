#!/bin/bash
#SBATCH --job-name=slm-address-bench-l40s
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:l40s:2
#SBATCH --cpus-per-task=16
#SBATCH --mem=160G
#SBATCH --time=7-00:00:00
#SBATCH --requeue
#SBATCH --signal=B:USR1@7200
#SBATCH --output=logs/slurm/slm-address-bench-l40s-%j.out
#
# CURATED BENCHMARK: address_bench (out-of-distribution, metric f2_addressed). Added 2026-10-06,
# ported from bubble-agent-pipeline/data/bench/address-bench. SLM_BENCHMARK_TASK pins the
# deterministic loader against the checksummed data/local/address_bench bundle.
#
# THE TASK. A wearable assistant hears everything around its wearer. Before it pays for a judge
# call it runs a cheap GATE: given the recent transcript plus one new line, is that line addressed
# to the assistant? The gate runs on every line where the judge runs on a few, so it is the
# on-device component and the one worth fine-tuning to a small quantized model.
#
# THERE IS NO LIVE FETCH FOR THIS CORPUS. gate_synthetic.jsonl (6,000 rows, 1,500 addressed) was
# generated by bubble-agent-pipeline's scripts/build_gate_synthetic.py and exists nowhere else —
# no HuggingFace mirror. It is vendored with a manifest and a sha256 the loader verifies, the same
# treatment proactive_listening's Google-Drive tarball gets. A checksum mismatch WARNS and
# continues: the run proceeds but its numbers are not comparable to anything in the notes.
#
# WHY THE METRIC IS f2_addressed AND NOT minority_f1. The gate's two errors are not equally bad.
# A MISS (the line was addressed, the gate said no) is the assistant staying silent when spoken to.
# A FALSE YES is one wasted judge call. F-beta with beta=2 weights recall 2x precision, pricing one
# miss at roughly four false yeses. The upstream harness expresses the same preference as "the
# threshold that misses no addressed turn", which needs a per-row P(true) read from logprobs —
# unavailable here, because this pipeline scores GENERATED TEXT from a quantized GGUF/MNN artifact.
#
# READ F2 WITH ITS DIAGNOSTICS OR NOT AT ALL. A model that answers `addressed` to everything gets
# recall 1.0, precision 0.25 and F2 = 0.625 — high enough to look like learning. The scorer also
# reports recall, precision and false_yes_rate, where that collapse reads as false_yes_rate=1.0,
# plus per-bucket accuracy over the corpus's 20 named failure modes (P1 explicit_wake_word … N5
# other_speaker_wake_word). tests/test_address_bench.py pins all of it.
#
# MINING IS OFF, BOTH KINDS. mining_sources=() because there is no mirror to offset into, and
# allow_paid_discovery=False because the corpora Exa would find instead (chatbot intent sets,
# wake-word datasets) carry a DIFFERENT label definition — that is contamination dressed as
# acquisition. Expect mine_new_real to retire itself on its first attempt; that is correct, not a
# failure. The data lever this task actually has is surgical_synthesis.
#
# Dedicated allocation: 2x L40S (synth server on GPU0, pipeline on GPU1 —
# the auto-2gpu profile in _l40s_task_body.sh). --requeue + USR1 checkpoint contract is a safety
# net against node failure/maintenance.
export SLM_CUDA_ISOLATION=1
export SLM_BENCHMARK_TASK=address_bench
# TEACHER VERIFICATION OF GENERATED ROWS: SHADOW MODE — the teacher judges every generated row and
# the verdict is recorded, but nothing is dropped. Same reasoning as topv2/goemotions/multiconer:
# `enforce` has been measured doing net harm (B267-family rejections of correct rows), and this
# task's `verifier_notes` are new and unmeasured. Grep `[verify:shadow]` for the rate.
export SLM_VERIFY_SYNTH=shadow
# SYNTHESIS GATE: bypassed deliberately, and the measurement is still taken honestly.
#
# Nobody has measured Qwen3.6-35B-A3B on this corpus with this metric — upstream's REPORT.md has no
# synthetic-set number for it, and calls the set "hard by design" (rules alone: AUC 0.61). Against
# a 0.80 gate that makes refusal likely, and on THIS task a refusal is fatal to the data lever in a
# way it is nowhere else: mining is off (no mirror, no paid discovery), so a refused synthesis
# leaves hyperparameters as the only intervention. BYPASS changes only the decision; the teacher's
# measured F2, the real gate and `bypassed=True` are still recorded on the verdict.
export SLM_TEACHER_SYNTH_BYPASS=1
export TASK="Fine tune a small model to decide whether the latest line of a transcribed conversation is addressed to the user's wearable voice assistant or not, targeting deployment on my Samsung Galaxy S24 Ultra with 12GB RAM and 256GB storage"
source "${SLM_ROOT:-$SLURM_SUBMIT_DIR}/tests/pipeline/_l40s_task_body.sh"
