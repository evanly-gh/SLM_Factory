# Documentation stays local: only README files are tracked.
# Anchored, so vendored trees (hardware/SmolChat-Android/**/docs/) are unaffected.
/docs/
/hardware/docs/
/agent/nodes/cold_start/hardware_metrics.md
/config/android_pool.md
/config/benchmark_baselines.md
# The paper's LaTeX sources never go to GitHub (they lived under docs/; these catch root-level drafts).
/*.tex
/*.bib
/*.bst
/*.cls
/*.drawio
/paper/
# Local evaluation inputs (fresh / external rows used by scripts/rescore_unseen.py).
data/fresh_sets/
data/external_eval/

# Machine-specific settings (template: site.env.example) and the default cache/scratch dirs.
/site.env
/.cache/
/.tmp/

# Editor / agent settings and experiment-tracker output.
.vscode/
.idea/
.claude/
wandb/
# Model weights (built under artifacts/ or downloaded). Ignore rules never untrack files: the small
# llama.cpp vocab GGUFs under hardware/SmolChat-Android/llama.cpp/models/ stay tracked as vendored files.
*.gguf
*.mnn
