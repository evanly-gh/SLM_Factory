ANTHROPIC_API_KEY=your_key_here
EXA_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here  # optional, for GPT-4.1 generation CoT
# REQUIRED when SLM_SYNTH_API_MODE=1; unused otherwise.
DEEPSEEK_API_KEY=your_key_here
# API teacher mode: route synthesis, CoT, the fitness gate, the accuracy-goal baseline and the
# eval judge to DeepSeek instead of the local vLLM Qwen3.6, so no vLLM server is launched.
# Equivalent to `python tests/pipeline/run.py --synth-api`.
# SLM_SYNTH_API_MODE=1
# SLM_SYNTH_API_MODEL=deepseek-v4-flash   # or deepseek-v4-pro (~3x the price)
# SLM_SYNTH_API_BASE_URL=https://api.deepseek.com
# DeepSeek V4 reasons BY DEFAULT and reasoning tokens are billed inside the completion budget, so
# the pipeline sends thinking={"type":"disabled"} on every teacher and judge call. Set to
# "enabled" only for a task that genuinely wants a reasoning teacher: measured at ~7,100 output
# tokens per generated row with it on, against a row that is one sentence plus a short JSON list.
# SLM_SYNTH_API_THINKING=disabled
SLM_SYNTH_ENDPOINT=http://127.0.0.1:8000/v1
# Generation judge defaults to SLM_SYNTH_ENDPOINT and requires this exact local model.
SLM_JUDGE_MODEL=Qwen/Qwen3.6-35B-A3B
# SLM_JUDGE_ENDPOINT=http://127.0.0.1:8000/v1  # optional dedicated local vLLM
SLM_JUDGE_ALLOW_REMOTE=0  # keep 0 for pipeline/long jobs
# SLM_JUDGE_CACHE_PATH=/stable/run/artifacts/local-judge-cache.jsonl
